#!/bin/bash
# pre-commit — コミット前にローカルで秘密情報をスキャンし、テストの弱体化（scripts/test-weaken-check.py があれば）を止める
# 配置: <project>/.git/hooks/pre-commit （chmod +x 必須）
# gitleaksが入っていれば実行、なければ簡易パターンチェックにフォールバック

if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --verbose
  if [ $? -ne 0 ]; then
    echo "❌ 秘密情報を検出。コミットを中止しました。"
    exit 1
  fi
else
  # フォールバック: 追加行だけを「値の形」で検査する（単語の一致では止めない）
  HIT=0
  if git diff --cached --name-only | grep -E '(^|/)(\.env(\.[^/]*)?|[^/]*\.pem|[^/]*\.key|id_rsa[^/]*)$' | grep -vE '\.(example|sample|template)$' | grep . ; then
    echo "⚠ 秘密情報のファイル（.env / 鍵）が staged に入っています。"
    HIT=1
  fi
  KNOWN='sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|AKfycb[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  ASSIGN='(api[_-]?key|secret|password|passwd|token)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{12,}["'"'"']'
  PLACEHOLDER='<[^>]*>|your_|xxx|example|dummy|changeme|\$\{|process\.env'
  while IFS=$'\t' read -r f n line; do
    if printf '%s' "$line" | grep -qE -e "$KNOWN" \
       || printf '%s' "$line" | grep -oiE -e "$ASSIGN" | grep -viE -e "$PLACEHOLDER" | grep -q .; then
      echo "⚠ 秘密情報らしき値: $f:$n"
      HIT=1
    fi
  done < <(git diff --cached -U0 | awk '
    /^\+\+\+ /{f=substr($0,7); next}
    /^@@/{match($0,/\+[0-9]+/); n=substr($0,RSTART+1,RLENGTH-1)+0; next}
    /^\+/{print f "\t" n "\t" substr($0,2); n++}')
  if [ "$HIT" -ne 0 ]; then
    echo "  誤検知なら該当行を見直す。どうしても通す場合は保守者が判断する（gitleaks未インストール）"
    exit 1
  fi
fi

# テストの弱体化（B38）: テストファイル・テスト設定が staged にあるときだけ scripts/test-weaken-check.py --staged を流す
# （assert の削除・書き換え、skip/only の追加、retries の増加。正当な変更は近くに weaken-ok: <理由> を書く）。
# install-git-hooks.sh が生成した hook は自分で流すので AIDD_WEAKEN_IN_HOOK=1 を渡してくる。そのときは重ねない。
if [ -z "${AIDD_WEAKEN_IN_HOOK:-}" ]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
  WEAKEN="$ROOT/scripts/test-weaken-check.py"
  if [ -f "$WEAKEN" ] && git diff --cached --name-only 2>/dev/null | grep -qE '(^|/)([^/]+\.(spec|test)\.[^/]+|[^/]+_test\.py|test_[^/]*\.py|(playwright|jest|vitest)\.config\.[^/]+|pytest\.ini|pyproject\.toml|setup\.cfg|tox\.ini|conftest\.py)$|(^|/)__tests__/|(^|/)tests/.*\.py$'; then
    if ! python3 "$WEAKEN" --staged; then
      echo "❌ テストの弱体化を検出。コミットを中止しました（正当な変更なら近くに weaken-ok: <理由> を書く）"
      exit 1
    fi
  fi
fi
exit 0
