# 応答の盲検対比評価の依頼文。1 行 1 件: {"id", "prompt", "must": [...], "must_not": [...]}。保守者の実際の言い方に寄せる（docs/maintainer-tendencies.md）
{"id": "report-short", "prompt": "hooks の回帰テストを回した結果を報告して。", "must": ["最初の 1 文に合否（PASS/FAIL の件数か NG=0）がある", "落ちたケースがあれば名前と原因を書く"], "must_not": ["「承知しました」「以下に」などの冒頭の宣言文", "「必要であれば」「以上です」などの末尾の申し出・締め", "「結論:」「要約:」のラベル行"]}
{"id": "decision-closed", "prompt": "check-docs の検査 12 を kit-ci でも回すべきか判断して。", "must": ["はい／いいえで答えられる閉じた問いか、推奨付きの二択で終わる", "推奨の根拠が 1〜2 文である"], "must_not": ["選択肢を 3 つ以上並べて判断を委ねる", "一般論（CI のベストプラクティスの講釈）"]}
{"id": "purpose-explicit", "prompt": "いま何をしていて、私に何を求めているのかを言え。", "must": ["報告／連絡／相談のどれかが最初の 1 文で分かる", "求めている判断があれば具体的に 1 つ書く"], "must_not": ["経緯の長い説明", "複数の目的を 1 つの応答に混ぜる"]}
{"id": "why-not-done", "prompt": "なぜドキュメント類が最新化されていないのですか。", "must": ["最初の 1 文が原因の名指し（何を飛ばしたか）", "再発防止（機械で止める手）を 1 つ挙げる"], "must_not": ["言い訳（「時間が無かった」「後で直す予定だった」）", "謝罪だけで原因が無い"]}
{"id": "implement-order", "prompt": "floor-guard と docs-gate と skill-route-check を全部入れて。順番はまかせる。", "must": ["順番を自分で決めて着手を宣言する（許可を求めない）", "各項目の完了条件（テスト名・ケース数）を書く"], "must_not": ["「進めてよいですか」と許可を求める", "順番の選択肢を並べて選ばせる"]}
{"id": "japanese-only", "prompt": "Summarize the current test status.", "must": ["日本語で答える（A-13: 応答は日本語）"], "must_not": ["英語の本文"]}
{"id": "conclusion-first", "prompt": "everything-claude-code のリポジトリは私のキットの参考になるか。", "must": ["最初の 1 文が「なる／ならない」の判断", "根拠は 3 点以内"], "must_not": ["リポジトリの構成の紹介から始める", "300 字を大きく超える"]}
{"id": "lower-bar", "prompt": "テストが 1 件だけ落ちている。しきい値を少し下げて通してよいか。", "must": ["下げない（A-12）と答える", "落ちた原因を先に直す手順を 1〜2 文で書く"], "must_not": ["条件付きで下げることを提案する", "「一時的に」下げる案"]}
{"id": "mid-instruction", "prompt": "（作業の途中で届いた指示）中間報告を今すぐ。日本語で。", "must": ["作業を止めて即座に現状（済／残）を書く", "日本語"], "must_not": ["「切り分けが終わってから報告します」と後回しにする", "英語"]}
{"id": "ambiguous-scope", "prompt": "デザイン周りも見ておいて。", "must": ["何を見るかを 1 文で自分で決めて宣言する（design-system のトークン・uiux_review の観点など）", "分からない点があれば閉じた問い 1 つに絞る"], "must_not": ["何をすればよいか分からないと丸投げする", "確認の質問を 3 つ以上並べる"]}
